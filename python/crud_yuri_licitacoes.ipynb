"""
Sistema de Acompanhamento de Obras Públicas - Módulo de Licitações

Como executar:
1. Instale as dependências: pip install -r requirements.txt
2. Configure o arquivo .env (modelo abaixo).
3. Execute: panel serve app.py --show

O arquivo .env pode ficar na mesma pasta deste app.py.
"""

import os
from pathlib import Path
from urllib.parse import quote_plus

import matplotlib.pyplot as plt
import pandas as pd
import panel as pn
from dotenv import load_dotenv
from sqlalchemy import URL, create_engine, text
from sqlalchemy.exc import IntegrityError, SQLAlchemyError


# ---------------------------------------------------------------------
# 1. CONFIGURAÇÃO E CONEXÃO COM O BANCO
# ---------------------------------------------------------------------

BASE_DIR = Path(__file__).resolve().parent

# Procura o .env primeiro na pasta deste arquivo e depois em ./python/.env.
ENV_CANDIDATES = [
    BASE_DIR / ".env",
    BASE_DIR / "python" / ".env",
]
ENV_FILE = next((path for path in ENV_CANDIDATES if path.exists()), None)

if ENV_FILE:
    load_dotenv(ENV_FILE)
else:
    load_dotenv()

DB_HOST = os.getenv("DB_HOST")
DB_NAME = os.getenv("DB_NAME")
DB_USER = os.getenv("DB_USER")
DB_PASS = os.getenv("DB_PASS")
DB_PORT = os.getenv("DB_PORT", "5432")

missing = [
    name for name, value in {
        "DB_HOST": DB_HOST,
        "DB_NAME": DB_NAME,
        "DB_USER": DB_USER,
        "DB_PASS": DB_PASS,
    }.items()
    if not value
]

if missing:
    raise RuntimeError(
        "Configuração do banco incompleta. Defina no arquivo .env: "
        + ", ".join(missing)
    )

# URL.create trata corretamente senhas com caracteres especiais.
database_url = URL.create(
    drivername="postgresql+psycopg2",
    username=DB_USER,
    password=DB_PASS,
    host=DB_HOST,
    port=int(DB_PORT),
    database=DB_NAME,
)

engine = create_engine(
    database_url,
    pool_pre_ping=True,
    pool_recycle=1800,
)

# Inicializa o Panel.
pn.extension("tabulator", notifications=True, sizing_mode="stretch_width")


# ---------------------------------------------------------------------
# 2. FUNÇÕES DE ACESSO A DADOS
# ---------------------------------------------------------------------

SELECT_ALL = text("""
    SELECT
        id_licitacao,
        numero_licitacao,
        modalidade,
        data_abertura,
        situacao
    FROM licitacao
    ORDER BY id_licitacao
""")


def buscar_todas_licitacoes():
    """Retorna todas as licitações cadastradas."""
    with engine.connect() as connection:
        return pd.read_sql_query(SELECT_ALL, connection)


def buscar_por_id(id_licitacao):
    """Busca uma licitação pelo ID."""
    sql = text("""
        SELECT id_licitacao, numero_licitacao, modalidade,
               data_abertura, situacao
        FROM licitacao
        WHERE id_licitacao = :id_licitacao
        ORDER BY id_licitacao
    """)
    with engine.connect() as connection:
        return pd.read_sql_query(
            sql, connection, params={"id_licitacao": id_licitacao}
        )


def buscar_por_numero(numero):
    """Busca licitações cujo número contenha o texto informado."""
    sql = text("""
        SELECT id_licitacao, numero_licitacao, modalidade,
               data_abertura, situacao
        FROM licitacao
        WHERE numero_licitacao ILIKE :numero
        ORDER BY id_licitacao
    """)
    with engine.connect() as connection:
        return pd.read_sql_query(
            sql, connection, params={"numero": f"%{numero}%"}
        )


def inserir_licitacao(numero, modalidade, data_abertura, situacao):
    sql = text("""
        INSERT INTO licitacao
            (numero_licitacao, modalidade, data_abertura, situacao)
        VALUES
            (:numero, :modalidade, :data_abertura, :situacao)
    """)
    with engine.begin() as connection:
        connection.execute(sql, {
            "numero": numero,
            "modalidade": modalidade,
            "data_abertura": data_abertura,
            "situacao": situacao,
        })


def atualizar_licitacao(id_licitacao, numero, modalidade, data_abertura, situacao):
    # Se a data não for informada, mantém a data que já está no banco.
    if data_abertura:
        sql = text("""
            UPDATE licitacao
            SET numero_licitacao = :numero,
                modalidade = :modalidade,
                data_abertura = :data_abertura,
                situacao = :situacao
            WHERE id_licitacao = :id_licitacao
        """)
        parametros = {
            "numero": numero,
            "modalidade": modalidade,
            "data_abertura": data_abertura,
            "situacao": situacao,
            "id_licitacao": id_licitacao,
        }
    else:
        sql = text("""
            UPDATE licitacao
            SET numero_licitacao = :numero,
                modalidade = :modalidade,
                situacao = :situacao
            WHERE id_licitacao = :id_licitacao
        """)
        parametros = {
            "numero": numero,
            "modalidade": modalidade,
            "situacao": situacao,
            "id_licitacao": id_licitacao,
        }

    with engine.begin() as connection:
        resultado = connection.execute(sql, parametros)
        return resultado.rowcount


def excluir_licitacao(id_licitacao):
    sql = text("""
        DELETE FROM licitacao
        WHERE id_licitacao = :id_licitacao
    """)
    with engine.begin() as connection:
        resultado = connection.execute(
            sql, {"id_licitacao": id_licitacao}
        )
        return resultado.rowcount


# ---------------------------------------------------------------------
# 3. WIDGETS DO FORMULÁRIO
# ---------------------------------------------------------------------

id_licitacao = pn.widgets.IntInput(
    name="ID da Licitação (para consultar, atualizar ou excluir)",
    value=0,
    start=0,
)

numero_licitacao = pn.widgets.TextInput(
    name="Número da Licitação * (único)",
    placeholder="Ex.: PE-025/2026",
)

modalidade = pn.widgets.TextInput(
    name="Modalidade *",
    placeholder="Ex.: Pregão Eletrônico, Concorrência Pública...",
)

data_abertura = pn.widgets.DatePicker(
    name="Data de Abertura *",
)

situacao = pn.widgets.Select(
    name="Situação da Licitação *",
    options=[
        "aberta",
        "em julgamento",
        "homologada",
        "deserta",
        "cancelada",
    ],
    value="aberta",
)

button_consultar = pn.widgets.Button(
    name="🔍 Consultar", button_type="primary"
)
button_inserir = pn.widgets.Button(
    name="➕ Inserir", button_type="success"
)
button_atualizar = pn.widgets.Button(
    name="✏️ Atualizar", button_type="warning"
)
button_excluir = pn.widgets.Button(
    name="🗑️ Excluir", button_type="danger"
)

btn_go_crud = pn.widgets.Button(
    name="📋 Gerenciar Licitações (CRUD)",
    button_type="primary",
    width=280,
)
btn_go_graficos = pn.widgets.Button(
    name="📊 Licitações por Situação",
    button_type="success",
    width=280,
)

main_area = pn.Column()
table_area = pn.Column()
message_area = pn.Column()


# ---------------------------------------------------------------------
# 4. COMPONENTES DE INTERFACE
# ---------------------------------------------------------------------

def mostrar_mensagem(mensagem, tipo="success"):
    """Exibe uma mensagem na área de avisos."""
    message_area.objects = [
        pn.pane.Alert(mensagem, alert_type=tipo)
    ]


def atualizar_tabela(dataframe=None, mensagem=None):
    """Atualiza a tabela exibida na tela."""
    try:
        if dataframe is None:
            dataframe = buscar_todas_licitacoes()

        componentes = []

        if mensagem:
            componentes.append(
                pn.pane.Alert(mensagem, alert_type="success")
            )

        if dataframe.empty:
            componentes.append(
                pn.pane.Alert(
                    "Nenhuma licitação encontrada.",
                    alert_type="warning",
                )
            )
        else:
            componentes.append(
                pn.widgets.Tabulator(
                    dataframe,
                    show_index=False,
                    pagination="local",
                    page_size=10,
                    sizing_mode="stretch_width",
                    height=400,
                )
            )

        table_area.objects = componentes

    except SQLAlchemyError as erro:
        table_area.objects = [
            pn.pane.Alert(
                f"Erro ao carregar licitações: {erro}",
                alert_type="danger",
            )
        ]


def validar_campos(obrigar_data=True):
    numero = numero_licitacao.value.strip()
    tipo = modalidade.value.strip()
    data = data_abertura.value

    if not numero:
        mostrar_mensagem(
            "Preencha o Número da Licitação.",
            "danger",
        )
        return None

    if not tipo:
        mostrar_mensagem(
            "Preencha a Modalidade da Licitação.",
            "danger",
        )
        return None

    if obrigar_data and not data:
        mostrar_mensagem(
            "Preencha a Data de Abertura.",
            "danger",
        )
        return None

    return numero, tipo, data, situacao.value


# ---------------------------------------------------------------------
# 5. OPERAÇÕES CRUD
# ---------------------------------------------------------------------

def on_consultar(event):
    try:
        message_area.objects = []
        id_value = id_licitacao.value
        numero = numero_licitacao.value.strip()

        if id_value and id_value > 0:
            resultado = buscar_por_id(id_value)
        elif numero:
            resultado = buscar_por_numero(numero)
        else:
            resultado = buscar_todas_licitacoes()

        atualizar_tabela(resultado)

        if resultado.empty:
            mostrar_mensagem(
                "Nenhuma licitação encontrada com os critérios informados.",
                "warning",
            )

    except SQLAlchemyError as erro:
        mostrar_mensagem(f"Erro na consulta: {erro}", "danger")


def on_inserir(event):
    dados = validar_campos(obrigar_data=True)
    if dados is None:
        return

    numero, tipo, data, estado = dados

    try:
        inserir_licitacao(numero, tipo, data, estado)
        atualizar_tabela(mensagem="Licitação cadastrada com sucesso!")
        mostrar_mensagem("Licitação cadastrada com sucesso!", "success")

    except IntegrityError as erro:
        mostrar_mensagem(
            "Não foi possível cadastrar. Verifique se o número da "
            "licitação já existe e se as restrições do banco foram atendidas. "
            f"Detalhe: {erro.orig}",
            "danger",
        )
    except SQLAlchemyError as erro:
        mostrar_mensagem(f"Erro ao inserir licitação: {erro}", "danger")


def on_atualizar(event):
    id_value = id_licitacao.value

    if not id_value or id_value <= 0:
        mostrar_mensagem(
            "Informe um ID válido (maior que zero) para atualizar.",
            "warning",
        )
        return

    dados = validar_campos(obrigar_data=False)
    if dados is None:
        return

    numero, tipo, data, estado = dados

    try:
        afetados = atualizar_licitacao(
            id_value, numero, tipo, data, estado
        )

        if afetados == 0:
            mostrar_mensagem(
                f"Nenhuma licitação encontrada com o ID {id_value}.",
                "warning",
            )
            return

        atualizar_tabela(
            mensagem=f"Licitação ID {id_value} atualizada com sucesso!"
        )
        mostrar_mensagem(
            f"Licitação ID {id_value} atualizada com sucesso!",
            "success",
        )

    except IntegrityError as erro:
        mostrar_mensagem(
            "Não foi possível atualizar. Verifique as restrições do banco "
            f"e se o número já está cadastrado. Detalhe: {erro.orig}",
            "danger",
        )
    except SQLAlchemyError as erro:
        mostrar_mensagem(f"Erro ao atualizar licitação: {erro}", "danger")


def on_excluir(event):
    id_value = id_licitacao.value

    if not id_value or id_value <= 0:
        mostrar_mensagem(
            "Informe um ID válido (maior que zero) para excluir.",
            "warning",
        )
        return

    try:
        afetados = excluir_licitacao(id_value)

        if afetados == 0:
            mostrar_mensagem(
                f"Nenhuma licitação encontrada com o ID {id_value}.",
                "warning",
            )
            return

        atualizar_tabela(
            mensagem=f"Licitação ID {id_value} excluída com sucesso!"
        )
        mostrar_mensagem(
            f"Licitação ID {id_value} excluída com sucesso!",
            "success",
        )

    except IntegrityError as erro:
        mostrar_mensagem(
            "Não foi possível excluir. Talvez existam registros de outras "
            f"tabelas relacionados a esta licitação. Detalhe: {erro.orig}",
            "danger",
        )
    except SQLAlchemyError as erro:
        mostrar_mensagem(f"Erro ao excluir licitação: {erro}", "danger")


# Registra os eventos dos botões.
button_consultar.on_click(on_consultar)
button_inserir.on_click(on_inserir)
button_atualizar.on_click(on_atualizar)
button_excluir.on_click(on_excluir)


# ---------------------------------------------------------------------
# 6. NAVEGAÇÃO
# ---------------------------------------------------------------------

def go_to_home():
    main_area.objects = [
        pn.Column(
            pn.pane.Markdown("## 🏠 Módulo de Licitações (RF06)"),
            pn.pane.Markdown(
                "Autor: **Yuri Alves de Araújo** | Tabela: `licitacao`"
            ),
            pn.Spacer(height=15),
            btn_go_crud,
            btn_go_graficos,
            align="center",
            margin=(30, 30, 30, 30),
        )
    ]


def go_to_crud():
    message_area.objects = []
    atualizar_tabela()

    formulario = pn.Column(
        pn.pane.Markdown("### 📑 Cadastro e Manutenção de Licitações"),
        id_licitacao,
        numero_licitacao,
        modalidade,
        data_abertura,
        situacao,
        pn.Row(button_consultar, button_inserir),
        pn.Row(button_atualizar, button_excluir),
        pn.Spacer(height=10),
        pn.widgets.Button(
            name="⬅ Voltar para Home",
            button_type="default",
            on_click=lambda event: go_to_home(),
        ),
        width=390,
        margin=(10, 20, 10, 10),
    )

    main_area.objects = [
        pn.Column(
            pn.Row(
                formulario,
                pn.Column(
                    message_area,
                    table_area,
                    sizing_mode="stretch_both",
                ),
                sizing_mode="stretch_width",
            ),
        )
    ]


def grafico_licitacoes_por_situacao():
    sql = text("""
        SELECT situacao, COUNT(*) AS quantidade
        FROM licitacao
        GROUP BY situacao
        ORDER BY situacao
    """)

    with engine.connect() as connection:
        df = pd.read_sql_query(sql, connection)

    if df.empty:
        return pn.pane.Alert(
            "Não existem licitações cadastradas para gerar o gráfico.",
            alert_type="warning",
        )

    fig, ax = plt.subplots(figsize=(8, 4))
    ax.bar(df["situacao"].astype(str), df["quantidade"])
    ax.set_title("Quantidade de Licitações por Situação")
    ax.set_xlabel("Situação")
    ax.set_ylabel("Total de Licitações")
    ax.tick_params(axis="x", rotation=20)
    fig.tight_layout()

    painel = pn.pane.Matplotlib(fig, tight=True)
    plt.close(fig)
    return painel


def go_to_graficos():
    try:
        grafico = grafico_licitacoes_por_situacao()
    except SQLAlchemyError as erro:
        grafico = pn.pane.Alert(
            f"Erro ao gerar gráfico: {erro}",
            alert_type="danger",
        )

    main_area.objects = [
        pn.Column(
            pn.pane.Markdown("### 📊 Estatísticas de Licitações"),
            grafico,
            pn.widgets.Button(
                name="⬅ Voltar para Home",
                button_type="default",
                on_click=lambda event: go_to_home(),
            ),
            margin=(20, 20, 20, 20),
        )
    ]


btn_go_crud.on_click(lambda event: go_to_crud())
btn_go_graficos.on_click(lambda event: go_to_graficos())


# ---------------------------------------------------------------------
# 7. INICIALIZAÇÃO DA APLICAÇÃO
# ---------------------------------------------------------------------

go_to_home()

app = pn.Column(
    pn.pane.Markdown("# 🏛️ Sistema de Acompanhamento de Obras Públicas"),
    main_area,
)

app.servable()
