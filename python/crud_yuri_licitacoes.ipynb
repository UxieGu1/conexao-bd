def grafico_licitacoes_por_situacao():
    sql = text("""
        SELECT situacao, COUNT(*) AS quantidade
        FROM licitacao
        GROUP BY situacao
        ORDER BY situacao
    """)

    with engine.connect() as connection:
        df = pd.read_sql_query(sql, connection)

    if df.empty:
        return pn.pane.Alert(
            "Não existem licitações cadastradas para gerar o gráfico.",
            alert_type="warning",
        )

    fig, ax = plt.subplots(figsize=(8, 4))
    ax.bar(df["situacao"].astype(str), df["quantidade"])
    ax.set_title("Quantidade de Licitações por Situação")
    ax.set_xlabel("Situação")
    ax.set_ylabel("Total de Licitações")
    ax.tick_params(axis="x", rotation=20)
    fig.tight_layout()

    painel = pn.pane.Matplotlib(fig, tight=True)
    plt.close(fig)
    return painel


def go_to_graficos():
    try:
        grafico = grafico_licitacoes_por_situacao()
    except SQLAlchemyError as erro:
        grafico = pn.pane.Alert(
            f"Erro ao gerar gráfico: {erro}",
            alert_type="danger",
        )

    main_area.objects = [
        pn.Column(
            pn.pane.Markdown("### 📊 Estatísticas de Licitações"),
            grafico,
            pn.widgets.Button(
                name="⬅ Voltar para Home",
                button_type="default",
                on_click=lambda event: go_to_home(),
            ),
            margin=(20, 20, 20, 20),
        )
    ]


btn_go_crud.on_click(lambda event: go_to_crud())
btn_go_graficos.on_click(lambda event: go_to_graficos())


